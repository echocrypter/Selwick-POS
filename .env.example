# Selwick POS — License Server Environment Template
# Copy this file to .env.local and populate the values for production deployment.
# NEVER commit .env.local to source control.

# Turso Cloud Database Configuration (libSQL)
TURSO_DATABASE_URL=libsql://selwick-<organization-or-username>.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Commercial Licensing Server Keys (Ed25519)
# SELWICK_LICENSE_PRIVATE_KEY=
# SELWICK_LICENSE_ADMIN_SECRET=

